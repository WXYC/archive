AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Better Auth configuration
# Server-side proxy destination (used by next.config.ts rewrites)
BETTER_AUTH_URL=https://api.wxyc.org/auth
# Client-side auth URL - must be full URL for build-time, but @wxyc/shared
# auth-client automatically uses same-origin /auth proxy when origins differ
NEXT_PUBLIC_BETTER_AUTH_URL=https://api.wxyc.org/auth
# Gates QR (RFC 8628 device-authorization) sign-in. Defaults to off; set to
# "true" or "1" to enable. Must also be enabled on dj.wxyc.org, which hosts the
# approval step — turning it on here alone sends DJs to a page that can't help.
NEXT_PUBLIC_QR_LOGIN_ENABLED=

# JWKS endpoint for JWT verification
BETTER_AUTH_JWKS_URL=https://api.wxyc.org/auth/jwks
# JWT claim validation. Optional: unset, tokens are verified by signature
# alone. Both values are the ORIGIN of the auth service's BETTER_AUTH_URL with
# any path stripped — better-auth's jwt plugin defaults iss and aud to that
# origin, and Backend-Service overrides neither. Confirmed against
# https://api.wxyc.org/auth/.well-known/openid-configuration, which reports the
# same issuer. Note it is the origin, not the /auth base URL.
BETTER_AUTH_ISSUER=https://api.wxyc.org
BETTER_AUTH_AUDIENCE=https://api.wxyc.org

# Playlist data sources (server-side only)
# Backend-Service, which serves the public GET /flowsheet/range read behind
# /api/daily-playlist. Defaults to production, so this only needs setting to
# point a local build at a staging Backend.
BACKEND_URL=https://api.wxyc.org
LIBRARY_METADATA_URL=https://library-metadata-lookup-production.up.railway.app/api/v1
# Bearer token for library-metadata-lookup (same LML_API_KEY shared by
# Backend-Service, request-o-matic, and tubafrenzy). Without it, artwork
# lookups get 401s from prod LML and pages silently show no artwork.
LML_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
